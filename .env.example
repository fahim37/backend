# Copy to server/.env and fill in. Never commit the real file.

NODE_ENV=development
PORT=4000
# HOST=0.0.0.0
# Reverse-proxy hops in front of the API in production: 1 = nginx, 2 = Vercel rewrite + nginx
# TRUST_PROXY=1
LOG_LEVEL=info

# MongoDB connection string, or "memory" for a throwaway in-process database
# (mongodb-memory-server; data is lost on exit).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=srsit

# Cloudinary (media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=srsit

# Auth: two different random strings, at least 32 characters each.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000

# Public site that receives POST /api/revalidate after content changes.
SITE_URL=http://localhost:3000
# Must equal REVALIDATE_SECRET in the site's .env.local.
REVALIDATE_SECRET=

# Initial admin, created automatically on first boot when no users exist,
# or with `npm run create-admin` (add `-- --reset` to reset the password).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Email notifications for new contact-form enquiries (optional).
# Leave SMTP_HOST empty to keep email off: enquiries are still saved in the admin inbox.
# Recipient: Admin → Site settings → Enquiry notifications, or ADMIN_EMAIL when that is blank.
SMTP_HOST=
# 587 = STARTTLS (default), 465 = implicit TLS.
SMTP_PORT=587
# true/false; leave empty to use TLS on port 465 only.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender shown in the inbox; must be an address your SMTP provider lets you send from.
# Defaults to SMTP_USER when that is an email address. Example:
# MAIL_FROM="SRS IT Website <no-reply@srsit.com>"
MAIL_FROM=
# Base URL of the admin for "Open in the admin" links in emails (defaults to SITE_URL).
ADMIN_URL=
# smtp (default), or json to render messages without delivering them (tests).
# MAIL_TRANSPORT=smtp

# Seed only: path to the website repo whose bundled content is imported (default ../srsit).
# SITE_DIR=../srsit
